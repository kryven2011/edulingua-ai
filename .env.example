# =============================================================================
# EduLingua AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control!
# =============================================================================

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
WEBHOOK_BASE_URL=https://your-domain.com
WEBHOOK_SECRET=generate_a_strong_random_secret_here
WEBHOOK_PATH=/telegram/webhook

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://edulingua:edulingua_password@postgres:5432/edulingua
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_DB=1
REDIS_CACHE_TTL=300

# --- AI Provider (Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_REQUEST_TIMEOUT=60
AI_MAX_CONTEXT_MESSAGES=20

# --- Rate Limiting ---
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_AI_REQUESTS_PER_HOUR_FREE=20
RATE_LIMIT_AI_REQUESTS_PER_HOUR_PRO=100
RATE_LIMIT_AI_REQUESTS_PER_HOUR_ULTIMATE=500

# --- Admin Panel ---
ADMIN_SECRET_KEY=generate_a_strong_jwt_secret_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_TOKEN_EXPIRE_MINUTES=60

# --- Application ---
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
WORKERS_COUNT=1

# --- Premium Subscription Limits ---
FREE_AI_DAILY_LIMIT=20
PRO_AI_DAILY_LIMIT=100
ULTIMATE_AI_DAILY_LIMIT=500
FREE_DAILY_TASKS=3
PRO_DAILY_TASKS=10
ULTIMATE_DAILY_TASKS=0

# --- Payments (configure when ready) ---
PAYMENT_PROVIDER_TOKEN=
PAYMENT_CURRENCY=USD

# --- Tunnel (local development) ---
# TUNNEL_TYPE=cloudflared
# TUNNEL_URL=
